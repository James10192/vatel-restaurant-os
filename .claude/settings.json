{
  "permissions": {
    "allow": [
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(rg *)",
      "Bash(pnpm typecheck*)", "Bash(pnpm lint*)", "Bash(pnpm test*)", "Bash(pnpm build*)",
      "Bash(gh issue view*)"
    ],
    "ask": [
      "Bash(pnpm add*)", "Bash(pnpm install*)", "Bash(git push*)", "Bash(vercel*)",
      "Bash(npx convex deploy*)", "Bash(pnpm exec convex deploy*)", "Edit(.githooks/**)", "Edit(.claude/settings.json)"
    ],
    "deny": [
      "Read(.env)", "Read(.env.local)", "Read(.env.production)",
      "Bash(rm -rf *)", "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)",
      "Bash(git commit*--no-verify*)", "Bash(git config core.hooksPath*)"
    ]
  }
}
